# API
API_PORT=4000
# Leave DATABASE_URL empty to use embedded PGlite (real Postgres engine, stored in .data/pglite).
# For docker compose Postgres: postgres://synapse:synapse@localhost:5432/synapse
DATABASE_URL=
SESSION_SECRET=change-me-to-a-random-64-char-string
STORAGE_DIR=./storage
# local (default) or s3. With s3, MEDIA_PUBLIC_URL is required. See docs/STORAGE.md.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# Local RustFS from docker compose: http://localhost:9000 with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public media base (CDN). Empty means ${PUBLIC_API_URL}/media.
MEDIA_PUBLIC_URL=
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email for invitations and password resets. Empty in development: emails go to the API log.
# Local Mailpit from docker compose: smtp://localhost:1025 (inbox at http://localhost:8025). See docs/EMAIL.md.
SMTP_URL=
MAIL_FROM=Synapse <no-reply@synapse.local>
# Base URL of the admin app, used to build the links in those emails.
ADMIN_PUBLIC_URL=http://localhost:3001
# Logins, invitation accepts and password resets per IP per minute.
LOGIN_RATE_LIMIT=10

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend (apps/api, workers)
NODE_ENV=development
# Set to true only when the API sits behind a trusted reverse proxy (uses X-Forwarded-For for rate limits / ip hash).
TRUST_PROXY=false
# Local-only demo password for `pnpm db:seed` users (owner/editor/sales/viewer@synapse.local, other-owner@otra.local).
# Never reuse it outside a development machine.
SEED_PASSWORD=demo-password-123
# Optional: path to the Blender executable. Without it RENDER jobs always end FAILED ("No render backend").
# Example: C:/Program Files/Blender Foundation/Blender 4.5/blender.exe. See docs/RENDER_PIPELINE.md.
BLENDER_PATH=
RENDER_DEVICE=OPTIX
RENDER_WIDTH=4096
RENDER_SAMPLES=128
RENDER_TIMEOUT_MINUTES=60
# Optional HDR sky, e.g. storage/hdri/kloofendal_48d_partly_cloudy_puresky_4k.hdr (Poly Haven, CC0).
RENDER_HDRI=
