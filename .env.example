# API
API_PORT=4000
# Leave DATABASE_URL empty to use embedded PGlite (real Postgres engine, stored in .data/pglite).
# For docker compose Postgres: postgres://synapse:synapse@localhost:5432/synapse
DATABASE_URL=
SESSION_SECRET=change-me-to-a-random-64-char-string
STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000
