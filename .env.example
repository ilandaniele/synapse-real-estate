# API
API_PORT=4000
# Leave DATABASE_URL empty to use embedded PGlite (real Postgres engine, stored in .data/pglite).
# For docker compose Postgres: postgres://synapse:synapse@localhost:5432/synapse
DATABASE_URL=
SESSION_SECRET=change-me-to-a-random-64-char-string
STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend (apps/api, workers)
NODE_ENV=development
# Set to true only when the API sits behind a trusted reverse proxy (uses X-Forwarded-For for rate limits / ip hash).
TRUST_PROXY=false
# Local-only demo password for `pnpm db:seed` users (owner/editor/sales/viewer@synapse.local, other-owner@otra.local).
# Never reuse it outside a development machine.
SEED_PASSWORD=demo-password-123
# Optional: path to the Blender executable. Without it RENDER jobs always end FAILED ("No render backend").
BLENDER_PATH=
