# Copy to .env.production on the server and fill in. Never commit the filled file.

# Public hostnames. With sslip.io they encode the VM's public IP, e.g. showroom.203-0-113-10.sslip.io
SHOWROOM_HOST=showroom.203-0-113-10.sslip.io
ADMIN_HOST=admin.203-0-113-10.sslip.io

NODE_ENV=production
# Generate on the server: openssl rand -hex 32
SESSION_SECRET=
# Empty: media and upload URLs are relative and served through Caddy on each app's own origin.
PUBLIC_API_URL=
# Must list both public origins exactly (https, no trailing slash).
CORS_ORIGINS=https://showroom.203-0-113-10.sslip.io,https://admin.203-0-113-10.sslip.io
TRUST_PROXY=true
# Empty: embedded PGlite stored in the "data" volume.
DATABASE_URL=

# Password for the demo users created by the one-time seed. Generate: openssl rand -base64 24
SEED_PASSWORD=
